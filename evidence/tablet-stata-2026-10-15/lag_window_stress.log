. use "data/processed/stata_ready.dta", clear

. isid ISO3 Year

. capture confirm variable panel_id

. if _rc encode ISO3, generate(panel_id)

. xtset panel_id Year

Panel variable: panel_id (strongly balanced)
 Time variable: Year, 2005 to 2022
         Delta: 1 unit

. capture drop yd_*

. quietly tab Year, generate(yd_)

. global digital_year_dummies "yd_2-yd_18"

. postfile stress str30 model double rc N Ng instruments sargan_p hansen_p ar1_p ar2_p b_internet
>  using "outputs/diagnostics/stress_status.dta", replace
(file outputs/diagnostics/stress_status.dta not found)

. foreach y in Growth ln_Productivity {
  2.     foreach lag in 2 3 {
  3.         display "STRESS_START outcome=`y' lag=`lag':`lag' diff GMM, one-step, collapse, robu
> st, 17 time dummies"
  4.         capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Infla
> tion RnD $digital_year_dummies, gmmstyle(`y' Internet Broadband ICT_Exports Unemployment Inflat
> ion RnD, lag(`lag' `lag') collapse) ivstyle($digital_year_dummies, equation(diff)) noleveleq ro
> bust small artests(2)
  5.         local err = _rc
  6.         if `err' == 0 {
  7.             post stress ("`y'_DIFF_L`lag'") (0) (e(N)) (e(N_g)) (e(j)) (e(sarganp)) (e(hanse
> np)) (e(ar1p)) (e(ar2p)) (_b[Internet])
  8.             display "STRESS_ESTIMATED outcome=`y' lag=`lag' N=" e(N) " instruments=" e(j)
  9.         }
 10.         else {
 11.             post stress ("`y'_DIFF_L`lag'") (`err') (.) (.) (.) (.) (.) (.) (.) (.)
 12.             display as error "STRESS_FAILED outcome=`y' lag=`lag' rc=`err'"
 13.         }
 14.     }
 15. }
