. foreach v in Growth ln_Productivity Internet Broadband ICT_Exports Unemployment Inflation RnD {
  2.     capture noisily xtunitroot ips `v', lags(1)
  3.     local ipserr = _rc
  4.     display as result "STATA_TEST_STATUS IPS `v' rc=`ipserr'"
  5.     capture noisily xtunitroot fisher `v', dfuller lags(1)
  6.     local fisherr = _rc
  7.     display as result "STATA_TEST_STATUS FISHER `v' rc=`fisherr'"
  8. }

