D:/Digital_Economy_Stata_Ready/plus\x\xtabond2.ado
*! xtabond2 3.7.2 9 February 2025
*! Copyright (C) 2003-25 David Roodman. May be distributed free.

. use "data/processed/stata_ready.dta", clear

. isid ISO3 Year

. assert inrange(Year, 2005, 2022)

. foreach v of varlist Growth Productivity Internet Broadband ICT_Exports Unemployment Inflation RnD {
  2.     assert !missing(`v')
  3. }

. assert Productivity > 0

. capture confirm variable ln_Productivity

. if _rc {
.     generate double ln_Productivity = ln(Productivity)
. }

. else {
.     assert !missing(ln_Productivity)
.     assert abs(ln_Productivity - ln(Productivity)) < 1e-7
. }

. capture confirm variable panel_id

. if _rc {
.     encode ISO3, generate(panel_id)
. }

. capture confirm numeric variable panel_id

. if _rc {
.     display as error "panel_id should be numeric."
.     exit 109
. }

. bysort ISO3: assert _N == 18

. xtset panel_id Year

Panel variable: panel_id (strongly balanced)
 Time variable: Year, 2005 to 2022
         Delta: 1 unit

. capture drop yd_*

. quietly tabulate Year, generate(yd_)

. * Non-redundant full-rank 2005-2022 time-indicator bases, empirically
. * verified against all six archived Stata estimates before changing code.
. * Difference GMM: yd_17 was auto-omitted for perfect collinearity.
. * System GMM: yd_4 was auto-omitted for perfect collinearity.
. * Explicitly omit the aliases rather than passing singular moment matrices.
. global digital_year_dummies_diff "yd_2-yd_16 yd_18"

. global digital_year_dummies_sys "yd_2-yd_3 yd_5-yd_18"

. display as result "STATA_DATA_PREFLIGHT_OK n=" _N
STATA_DATA_PREFLIGHT_OK n=846

. display as text "The raw data and two-way time indicators passed structure checks; no GMM was fitted yet."
The raw data and two-way time indicators passed structure checks; no GMM was fitted yet.

. 
end of do-file

. local preflight=_rc

. if `preflight' {
.  display as error "DIFF_REPAIR_PREFLIGHT_FAILED rc=`preflight'"
.  log close
.  exit `preflight'
. }

. postfile v str20 outcome str10 estimator double rc N Ng instruments b_lag se_lag b_internet se_internet p_internet joi
> nt_p hansen_p sargan_p ar1_p ar2_p using "outputs/professor/diff_l23_two_outcomes_stats.dta", replace
(file outputs/professor/diff_l23_two_outcomes_stats.dta not found)

. foreach y in Growth ln_Productivity {
  2.  foreach estimator in twostep onestep {
  3.   display as result "DIFF_REPAIR_START outcome=`y' estimator=`estimator' lag2_3_only"
  4.   if "`estimator'"=="twostep" {
  5.    capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Inflation RnD $digital_year_dummi
> es_diff, gmmstyle(`y', lag(2 3) collapse) gmmstyle(Internet Broadband ICT_Exports RnD, lag(2 3) collapse) gmmstyle(Une
> mployment Inflation, lag(2 3) collapse) ivstyle($digital_year_dummies_diff, equation(diff)) noleveleq twostep robust s
> mall artests(2)
  6.   }
  7.   else {
  8.    capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Inflation RnD $digital_year_dummi
> es_diff, gmmstyle(`y', lag(2 3) collapse) gmmstyle(Internet Broadband ICT_Exports RnD, lag(2 3) collapse) gmmstyle(Une
> mployment Inflation, lag(2 3) collapse) ivstyle($digital_year_dummies_diff, equation(diff)) noleveleq robust small art
> ests(2)
  9.   }
 10.   local rc=_rc
 11.   if `rc'==0 {
 12.    local n=e(N)
 13.    local ng=e(N_g)
 14.    local j=e(j)
 15.    local lagb=_b[L.`y']
 16.    local lagse=_se[L.`y']
 17.    local internet=_b[Internet]
 18.    local ise=_se[Internet]
 19.    local ip=2*ttail(`ng'-1,abs(`internet'/`ise'))
 20.    local jp=.
 21.    capture noisily test Internet Broadband ICT_Exports
 22.    if _rc==0 local jp=r(p)
 23.    local hp=e(hansenp)
 24.    local sp=e(sarganp)
 25.    local a1=e(ar1p)
 26.    local a2=e(ar2p)
 27.    post v ("`y'") ("`estimator'") (0) (`n') (`ng') (`j') (`lagb') (`lagse') (`internet') (`ise') (`ip') (`jp') (`hp
> ') (`sp') (`a1') (`a2')
 28.    display as result "DIFF_REPAIR_OK outcome=`y' estimator=`estimator' N=`n' groups=`ng' instruments=`j' Hansen=`hp
> ' Sargan=`sp' AR1=`a1' AR2=`a2' InternetP=`ip' JointDigitalP=`jp'"
 29.   }
 30.   else {
 31.    post v ("`y'") ("`estimator'") (`rc') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 32.    display as error "DIFF_REPAIR_FAILED outcome=`y' estimator=`estimator' rc=`rc'"
 33.   }
 34.  }
 35. }
