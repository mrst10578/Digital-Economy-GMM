 20.             local lag_se = _se[L.`y']
 21.             local internet_b = _b[Internet]
 22.             local internet_se = _se[Internet]
 23.             local broadband_b = _b[Broadband]
 24.             local broadband_se = _se[Broadband]
 25.             local ict_b = _b[ICT_Exports]
 26.             local ict_se = _se[ICT_Exports]
 27.             local t_internet = `internet_b' / `internet_se'
 28.             local p_internet = 2*ttail(e(N_g)-1, abs(`t_internet'))
 29.             local diffh_dep_level = .
 30.             local diffh_ctrl = .
 31.             capture matrix __prof_dh = e(diffsargan)
 32.             if _rc == 0 {
 33.                 if rowsof(__prof_dh) >= 5 & colsof(__prof_dh) >= 4 {
 34.                     local diffh_dep_level = el(__prof_dh,5,3)
 35.                     local diffh_ctrl = el(__prof_dh,5,4)
 36.                 }
 37.             }
 38.             post prof ("`y'") ("`mode'") (0) (`n') (`ng') (`j') (`lag_b') (`lag_se') (`internet_b') (`internet_se')
>  (`p_internet') (`broadband_b') (`broadband_se') (`ict_b') (`ict_se') (`sarg') (`hans') (`ar1') (`ar2') (`diffh_dep_le
> vel') (`diffh_ctrl')
 39.             capture estimates save "outputs/professor/`y'_`mode'.ster", replace
 40.             display as result "PROFESSOR_OK outcome=`y' method=`mode' N=`n' instruments=`j' Hansen=`hans' AR1=`ar1'
>  AR2=`ar2' DHlevel=`diffh_dep_level'"
 41.         }
 42.         else {
 43.             post prof ("`y'") ("`mode'") (`rc') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
>  (.)
 44.             display as error "PROFESSOR_FAILED outcome=`y' method=`mode' rc=`rc'"
 45.         }
 46.     }
 47. }
