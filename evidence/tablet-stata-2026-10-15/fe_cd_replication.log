. use "data/processed/stata_ready.dta", clear

. capture confirm variable panel_id

. if _rc encode ISO3, gen(panel_id)

. xtset panel_id Year

Panel variable: panel_id (strongly balanced)
 Time variable: Year, 2005 to 2022
         Delta: 1 unit

. postfile cdp str36 model double N years groups cd_stat cd_p b_internet using "outputs/diagnosti
> cs/fe_cd_repl.dta", replace

. capture program drop _fe_cd

. program define _fe_cd
  1.     version 16.0
  2.     syntax, OUTCOME(name) DYNAMIC(integer)
  3.     preserve
  4.     local rhs ""
  5.     if `dynamic' == 1 local rhs "L.`outcome'"
  6.     quietly regress `outcome' `rhs' Internet Broadband ICT_Exports Unemployment Inflation Rn
> D i.panel_id i.Year
  7.     local num_obs = e(N)
  8.     local beta = _b[Internet]
  9.     gen byte __cd_in = e(sample)
 10.     predict double __cd_r if __cd_in, residuals
 11.     keep if __cd_in
 12.     keep Year panel_id __cd_r
 13.     reshape wide __cd_r, i(Year) j(panel_id)
 14.     quietly ds __cd_r*
 15.     local vars `r(varlist)'
 16.     mata: X = st_data(., tokens(st_local("vars")))
 17.     mata: CC = correlation(X)
 18.     mata: NN = cols(X)
 19.     mata: TT = rows(X)
 20.     mata: sumrho = (sum(vec(CC))-NN)/2
 21.     mata: zcd = sqrt(2*TT/(NN*(NN-1))) * sumrho
 22.     mata: st_numscalar("__cd_z", zcd)
 23.     mata: st_numscalar("__cd_p", 2*normal(-abs(zcd)))
 24.     mata: st_numscalar("__cd_N", NN)
 25.     mata: st_numscalar("__cd_T", TT)
 26.     local label "static"
 27.     if `dynamic' == 1 local label "dynamic"
 28.     post cdp ("`outcome'_`label'") (`num_obs') (__cd_T) (__cd_N) (__cd_z) (__cd_p) (`beta')
 29.     display as result "CD_ESTIMATED outcome=`outcome' model=`label' T=" __cd_T " N=" __cd_N 
> " z=" __cd_z " p=" __cd_p " internet=" `beta'
 30.     restore
 31. end

. foreach y in Growth ln_Productivity {
  2.     foreach dynamic in 0 1 {
  3.         capture noisily _fe_cd, outcome(`y') dynamic(`dynamic')
  4.         display as result "CD_RUN_RC y=`y' dynamic=`dynamic' rc=" _rc
  5.     }
  6. }
