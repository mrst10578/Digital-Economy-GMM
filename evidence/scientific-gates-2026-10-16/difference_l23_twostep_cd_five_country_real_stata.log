. foreach y in Growth ln_Productivity {
  2.  display as result "DIFF_TWOSTEP_CD_START outcome=`y'"
  3.  capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Inflation RnD
>  $digital_year_dummies_diff, gmmstyle(`y', lag(2 3) collapse) gmmstyle(Internet Broadband ICT_Ex
> ports RnD, lag(2 3) collapse) gmmstyle(Unemployment Inflation, lag(2 3) collapse) ivstyle($digit
> al_year_dummies_diff, equation(diff)) noleveleq twostep robust small artests(2)
  4.  local est_rc=_rc
  5.  if `est_rc'==0 {
  6.   preserve
  7.   quietly generate byte __gmm_sample=e(sample)
  8.   capture noisily predict double __gmm_resid if __gmm_sample, residuals
  9.   local pred_rc=_rc
 10.   if `pred_rc'==0 {
 11.    quietly keep if __gmm_sample & !missing(__gmm_resid)
 12.    quietly keep Year panel_id __gmm_resid
 13.    quietly reshape wide __gmm_resid, i(Year) j(panel_id)
 14.    quietly ds __gmm_resid*
 15.    local cols `r(varlist)'
 16.    mata: __X=st_data(.,tokens(st_local("cols")))
 17.    mata: __R=correlation(__X)
 18.    mata: __N=cols(__X)
 19.    mata: __T=rows(__X)
 20.    mata: __CD=sqrt(2*__T/(__N*(__N-1)))*(sum(vec(__R))-__N)/2
 21.    mata: st_numscalar("__cd_n",__N)
 22.    mata: st_numscalar("__cd_t",__T)
 23.    mata: st_numscalar("__cd_z",__CD)
 24.    local pairs=scalar(__cd_n)*(scalar(__cd_n)-1)/2
 25.    local p=2*normal(-abs(scalar(__cd_z)))
 26.    post cd ("`y'") (0) (__cd_n) (__cd_t) (`pairs') (__cd_z) (`p')
 27.    display as result "DIFF_TWOSTEP_CD_OK outcome=`y' groups=" __cd_n " years=" __cd_t " pairs
> =`pairs' CD=" __cd_z " p=`p'"
 28.   }
 29.   else {
 30.    post cd ("`y'") (`pred_rc') (.) (.) (.) (.) (.)
 31.    display as error "DIFF_TWOSTEP_CD_PREDICT_FAILED outcome=`y' rc=`pred_rc'"
 32.   }
 33.   restore
 34.  }
 35.  else {
 36.   post cd ("`y'") (`est_rc') (.) (.) (.) (.) (.)
 37.   display as error "DIFF_TWOSTEP_CD_EST_FAILED outcome=`y' rc=`est_rc'"
 38.  }
 39. }
