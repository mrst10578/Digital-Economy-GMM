. foreach y in Growth ln_Productivity {
  2.     display as result "LEVEL_REMOVAL_START outcome=`y' fixed collapsed lag2 two-step Differe
> nce GMM"
  3.     capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Inflation
>  RnD $digital_year_dummies_diff, gmmstyle(`y', lag(2 2) collapse) gmmstyle(Internet Broadband I
> CT_Exports RnD, lag(2 2) collapse) gmmstyle(Unemployment Inflation, lag(2 2) collapse) ivstyle(
> $digital_year_dummies_diff, equation(diff)) noleveleq twostep robust small artests(2)
  4.     local rc = _rc
  5.     if `rc' == 0 {
  6.         local n=e(N)
  7.         local ng=e(N_g)
  8.         local j=e(j)
  9.         local bl=_b[L.`y']
 10.         local sl=_se[L.`y']
 11.         local bi=_b[Internet]
 12.         local si=_se[Internet]
 13.         local pi=2*ttail(`ng'-1,abs(`bi'/`si'))
 14.         local ha=e(hansenp)
 15.         local sa=e(sarganp)
 16.         local a1=e(ar1p)
 17.         local a2=e(ar2p)
 18.         post lev ("`y'") (0) (`n') (`ng') (`j') (`bl') (`sl') (`bi') (`si') (`pi') (`ha') (`
> sa') (`a1') (`a2')
 19.         display as result "LEVEL_REMOVAL_OK outcome=`y' N=`n' groups=`ng' instruments=`j' la
> gcoef=`bl' Internet=`bi' Hansen=`ha' AR1=`a1' AR2=`a2'"
 20.     }
 21.     else {
 22.         post lev ("`y'") (`rc') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 23.         display as error "LEVEL_REMOVAL_FAILED outcome=`y' rc=`rc'"
 24.     }
 25. }
