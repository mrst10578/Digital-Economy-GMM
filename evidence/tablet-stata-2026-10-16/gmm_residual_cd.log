. do "stata/01_environment_and_data.do"

. * Source DTA comes from this repository's audited workbook.
. version 16.0

. capture confirm file "data/processed/stata_ready.dta"

. if _rc {
.     display as error "Missing data/processed/stata_ready.dta. Extract full handoff ZIP first."
.     exit 601
. }

. capture which xtabond2

. if _rc {
.     display as error "xtabond2 is missing. In licensed Stata: ssc install xtabond2, replace"
.     exit 499
. }

. which xtabond2
D:/Digital_Economy_Stata_Ready/plus\x\xtabond2.ado
*! xtabond2 3.7.2 9 February 2025
*! Copyright (C) 2003-25 David Roodman. May be distributed free.

. use "data/processed/stata_ready.dta", clear

. isid ISO3 Year

. assert inrange(Year, 2005, 2022)

. foreach v of varlist Growth Productivity Internet Broadband ICT_Exports Unemployment Inflation 
> RnD {
  2.     assert !missing(`v')
  3. }

. assert Productivity > 0

. capture confirm variable ln_Productivity

. if _rc {
.     generate double ln_Productivity = ln(Productivity)
. }

. else {
.     assert !missing(ln_Productivity)
.     assert abs(ln_Productivity - ln(Productivity)) < 1e-7
. }

. capture confirm variable panel_id

. if _rc {
.     encode ISO3, generate(panel_id)
. }

. capture confirm numeric variable panel_id

. if _rc {
.     display as error "panel_id should be numeric."
.     exit 109
. }

. bysort ISO3: assert _N == 18

. xtset panel_id Year

Panel variable: panel_id (strongly balanced)
 Time variable: Year, 2005 to 2022
         Delta: 1 unit

. capture drop yd_*

. quietly tabulate Year, generate(yd_)

. * Non-redundant full-rank 2005-2022 time-indicator bases, empirically
. * verified against all six archived Stata estimates before changing code.
. * Difference GMM: yd_17 was auto-omitted for perfect collinearity.
. * System GMM: yd_4 was auto-omitted for perfect collinearity.
. * Explicitly omit the aliases rather than passing singular moment matrices.
. global digital_year_dummies_diff "yd_2-yd_16 yd_18"

. global digital_year_dummies_sys "yd_2-yd_3 yd_5-yd_18"

. display as result "STATA_DATA_PREFLIGHT_OK n=" _N
STATA_DATA_PREFLIGHT_OK n=846

. display as text "The raw data and two-way time indicators passed structure checks; no GMM was f
> itted yet."
The raw data and two-way time indicators passed structure checks; no GMM was fitted yet.

. 
end of do-file

. postfile cdx str20 outcome double rc N groups years cd_stat cd_p using "outputs/scientific/gmm_
> residual_cd.dta", replace
(file outputs/scientific/gmm_residual_cd.dta not found)

. foreach y in Growth ln_Productivity {
  2.     display "GMM_RESID_CD_START outcome=`y'"
  3.     capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Inflation
>  RnD $digital_year_dummies_diff, gmmstyle(`y' Internet Broadband ICT_Exports Unemployment Infla
> tion RnD, lag(2 3) collapse) ivstyle($digital_year_dummies_diff, equation(diff)) noleveleq robu
> st small artests(2)
  4.     local rc = _rc
  5.     if `rc' == 0 {
  6.         preserve
  7.         quietly generate byte __sample = e(sample)
  8.         capture noisily predict double __err if __sample, residuals
  9.         local predict_rc = _rc
 10.         if `predict_rc' == 0 {
 11.             quietly keep if __sample & !missing(__err)
 12.             quietly keep Year panel_id __err
 13.             quietly reshape wide __err, i(Year) j(panel_id)
 14.             quietly ds __err*
 15.             local vars `r(varlist)'
 16.             mata: X = st_data(., tokens(st_local("vars")))
 17.             mata: R = correlation(X)
 18.             mata: N = cols(X)
 19.             mata: T = rows(X)
 20.             mata: cdstat = sqrt(2*T/(N*(N-1))) * (sum(vec(R))-N)/2
 21.             mata: st_numscalar("__gmcd_stat", cdstat)
 22.             mata: st_numscalar("__gmcd_p", 2*normal(-abs(cdstat)))
 23.             mata: st_numscalar("__gmcd_n", N)
 24.             mata: st_numscalar("__gmcd_t", T)
 25.             post cdx ("`y'") (0) (__gmcd_n*__gmcd_t) (__gmcd_n) (__gmcd_t) (__gmcd_stat) (__
> gmcd_p)
 26.             display as result "GMM_RESID_CD_OK outcome=`y' N=" __gmcd_n " T=" __gmcd_t " sta
> tistic=" __gmcd_stat " p=" __gmcd_p
 27.         }
 28.         else {
 29.             post cdx ("`y'") (`predict_rc') (.) (.) (.) (.) (.)
 30.             display as error "GMM_RESID_CD_PREDICT_FAILED outcome=`y' rc=`predict_rc'"
 31.         }
 32.         restore
 33.     }
 34.     else {
 35.         post cdx ("`y'") (`rc') (.) (.) (.) (.) (.)
 36.         display as error "GMM_RESID_CD_EST_FAILED outcome=`y' rc=`rc'"
 37.     }
 38. }
