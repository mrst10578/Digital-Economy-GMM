. foreach variable in ln_Productivity D_ln_Productivity {
  2.     local transform "level"
  3.     if "`variable'"=="D_ln_Productivity" local transform "difference"
  4.     foreach lag in 1 2 {
  5.         foreach deterministic in drift trend {
  6.             local trendopt ""
  7.             if "`deterministic'"=="trend" local trendopt "trend"
  8.             display as result "UNITROOT_START variable=`variable' type=IPS deterministic=`det
> erministic' lags=`lag'"
  9.             capture noisily xtunitroot ips `variable', lags(`lag') `trendopt'
 10.             local err=_rc
 11.             local p1=.
 12.             local p2=.
 13.             if `err'==0 {
 14.                 local p1=r(p_wtbar)
 15.                 local p2=r(p_tbar)
 16.                 return list
 17.             }
 18.             post ur ("`variable'") ("`transform'") ("IPS") ("`deterministic'") (`lag') (`err'
> ) (`p1') (`p2')
 19.             display as result "UNITROOT_RESULT variable=`variable' test=IPS deterministic=`de
> terministic' lag=`lag' rc=`err' p_wtbar=`p1' p_tbar=`p2'"
 20.             display as result "UNITROOT_START variable=`variable' type=FisherADF deterministi
> c=`deterministic' lags=`lag'"
 21.             capture noisily xtunitroot fisher `variable', dfuller lags(`lag') `trendopt'
 22.             local err=_rc
 23.             local p1=.
 24.             local p2=.
 25.             if `err'==0 {
 26.                 local p1=r(p_P)
 27.                 local p2=r(p_Z)
 28.                 return list
 29.             }
 30.             post ur ("`variable'") ("`transform'") ("Fisher") ("`deterministic'") (`lag') (`e
> rr') (`p1') (`p2')
 31.             display as result "UNITROOT_RESULT variable=`variable' test=Fisher deterministic=
> `deterministic' lag=`lag' rc=`err' p_inverse_chi2=`p1' p_Z=`p2'"
 32.         }
 33.     }
 34. }
