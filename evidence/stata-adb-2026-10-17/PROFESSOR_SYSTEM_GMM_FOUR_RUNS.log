. foreach y in Growth ln_Productivity {
  2.     foreach mode in twostep onestep {
  3.         display as result "PROFESSOR_START outcome=`y' method=`mode'"
  4.         if "`mode'" == "twostep" {
  5.             capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Inflation RnD $digital_y
> ear_dummies_sys, gmmstyle(`y', lag(2 2) collapse split) gmmstyle(Internet Broadband ICT_Exports RnD, lag(2 2) collapse
> ) gmmstyle(Unemployment Inflation, lag(2 2) collapse) ivstyle($digital_year_dummies_sys) twostep robust small artests(
> 2)
  6.         }
  7.         else {
  8.             capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Inflation RnD $digital_y
> ear_dummies_sys, gmmstyle(`y', lag(2 2) collapse split) gmmstyle(Internet Broadband ICT_Exports RnD, lag(2 2) collapse
> ) gmmstyle(Unemployment Inflation, lag(2 2) collapse) ivstyle($digital_year_dummies_sys) robust small artests(2)
  9.         }
 10.         local rc = _rc
 11.         if `rc' == 0 {
 12.             local n = e(N)
 13.             local ng = e(N_g)
 14.             local j = e(j)
