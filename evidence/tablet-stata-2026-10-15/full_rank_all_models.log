. capture program drop _rank_save

. program define _rank_save
  1.     syntax , NAME(string) RC(integer)
  2.     if `rc' == 0 {
  3.         post basis ("`name'") (0) (e(N)) (e(N_g)) (e(j)) (e(sarganp)) (e(hansenp)) (e(ar1p))
>  (e(ar2p)) (_b[Internet])
  4.         display "FULL_RANK_ESTIMATED=`name' instruments=" e(j) " groups=" e(N_g)
  5.     }
  6.     else {
  7.         post basis ("`name'") (`rc') (.) (.) (.) (.) (.) (.) (.) (.)
  8.         display as error "FULL_RANK_FAILED=`name' rc=`rc'"
  9.     }
 10. end

