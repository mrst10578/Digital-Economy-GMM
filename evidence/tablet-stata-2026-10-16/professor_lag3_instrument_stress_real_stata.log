. which xtabond2
D:/Digital_Economy_Stata_Ready/plus\x\xtabond2.ado
*! xtabond2 3.7.2 9 February 2025
*! Copyright (C) 2003-25 David Roodman. May be distributed free.

. use "data/processed/stata_ready.dta", clear

. isid ISO3 Year

. assert inrange(Year, 2005, 2022)

. foreach v of varlist Growth Productivity Internet Broadband ICT_Exports Unemployment Inflation 
> RnD {
  2.     assert !missing(`v')
  3. }

. assert Productivity > 0

. capture confirm variable ln_Productivity

. if _rc {
.     generate double ln_Productivity = ln(Productivity)
. }

. else {
.     assert !missing(ln_Productivity)
.     assert abs(ln_Productivity - ln(Productivity)) < 1e-7
. }

. capture confirm variable panel_id

. if _rc {
.     encode ISO3, generate(panel_id)
. }

. capture confirm numeric variable panel_id

. if _rc {
.     display as error "panel_id should be numeric."
.     exit 109
. }

. bysort ISO3: assert _N == 18

. xtset panel_id Year

Panel variable: panel_id (strongly balanced)
 Time variable: Year, 2005 to 2022
         Delta: 1 unit

. capture drop yd_*

. quietly tabulate Year, generate(yd_)

. * Non-redundant full-rank 2005-2022 time-indicator bases, empirically
. * verified against all six archived Stata estimates before changing code.
. * Difference GMM: yd_17 was auto-omitted for perfect collinearity.
. * System GMM: yd_4 was auto-omitted for perfect collinearity.
. * Explicitly omit the aliases rather than passing singular moment matrices.
. global digital_year_dummies_diff "yd_2-yd_16 yd_18"

. global digital_year_dummies_sys "yd_2-yd_3 yd_5-yd_18"

. display as result "STATA_DATA_PREFLIGHT_OK n=" _N
STATA_DATA_PREFLIGHT_OK n=846

. display as text "The raw data and two-way time indicators passed structure checks; no GMM was f
> itted yet."
The raw data and two-way time indicators passed structure checks; no GMM was fitted yet.

. 
end of do-file

. local preflight_rc = _rc

. if `preflight_rc' {
.   display as error "LAG3_PREFLIGHT_FAILED rc=`preflight_rc'"
.   log close
.   exit `preflight_rc'
. }

. postfile p3 str20 outcome double rc N Ng instruments b_lag b_internet se_internet p_internet sa
> rgan_p hansen_p ar1_p ar2_p diffh_level_dep_p diffh_controls_p using "outputs/professor/profess
> or_lag3_instrument_stress.dta", replace

. foreach y in Growth ln_Productivity {
  2.   display as result "LAG3_START outcome=`y': only lag 3 for all GMM-style variables"
  3.   capture noisily xtabond2 `y' L.`y' Internet Broadband ICT_Exports Unemployment Inflation R
> nD $digital_year_dummies_sys, gmmstyle(`y', lag(3 3) collapse split) gmmstyle(Internet Broadban
> d ICT_Exports RnD, lag(3 3) collapse) gmmstyle(Unemployment Inflation, lag(3 3) collapse) ivsty
> le($digital_year_dummies_sys) twostep robust small artests(2)
  4.   local fitrc = _rc
  5.   if `fitrc'==0 {
  6.     local n=e(N)
  7.     local ng=e(N_g)
  8.     local j=e(j)
  9.     local bl=_b[L.`y']
 10.     local bi=_b[Internet]
 11.     local si=_se[Internet]
 12.     local pi=2*ttail(`ng'-1,abs(`bi'/`si'))
 13.     local sp=e(sarganp)
 14.     local hp=e(hansenp)
 15.     local a1=e(ar1p)
 16.     local a2=e(ar2p)
 17.     local dhdep=.
 18.     local dhctrl=.
 19.     capture matrix __diffh = e(diffsargan)
 20.     if _rc==0 {
 21.       if rowsof(__diffh)==5 & inlist(colsof(__diffh),3,4) {
 22.         * e(diffsargan) contains 5 statistic rows. xtabond2 may omit the
.         * non-identifiable overall-level group, giving 3 instead of 4 columns.
.         * In either layout, the last two columns are Y-level and controls.
.         local ncols=colsof(__diffh)
 23.         local dhdep=el(__diffh,5,`ncols'-1)
 24.         local dhctrl=el(__diffh,5,`ncols')
 25.         display as result "LAG3_DH_MATRIX_LAYOUT outcome=`y' columns=`ncols' dependent_level
> _p=`dhdep' controls_p=`dhctrl'"
 26.       }
 27.     }
 28.     post p3 ("`y'") (0) (`n') (`ng') (`j') (`bl') (`bi') (`si') (`pi') (`sp') (`hp') (`a1') 
> (`a2') (`dhdep') (`dhctrl')
 29.     display as result "LAG3_OK outcome=`y' N=`n' instruments=`j' internet=`bi' internet_p=`p
> i' hansen=`hp' AR1=`a1' AR2=`a2' DHlevel=`dhdep'"
 30.   }
 31.   else {
 32.     post p3 ("`y'") (`fitrc') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 33.     display as error "LAG3_FAILED outcome=`y' rc=`fitrc'"
 34.   }
 35. }
