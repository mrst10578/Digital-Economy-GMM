D:/Digital_Economy_Stata_Ready/plus\x\xtabond2.ado
*! xtabond2 3.7.2 9 February 2025
*! Copyright (C) 2003-25 David Roodman. May be distributed free.

. use "data/processed/stata_ready.dta", clear

. isid ISO3 Year

. assert inrange(Year, 2005, 2022)

. foreach v of varlist Growth Productivity Internet Broadband ICT_Exports Unemployment Inflation 
> RnD {
  2.     assert !missing(`v')
  3. }

. assert Productivity > 0

. capture confirm variable ln_Productivity

. if _rc {
.     generate double ln_Productivity = ln(Productivity)
. }

. else {
.     assert !missing(ln_Productivity)
.     assert abs(ln_Productivity - ln(Productivity)) < 1e-7
. }

. capture confirm variable panel_id

. if _rc {
.     encode ISO3, generate(panel_id)
. }

. capture confirm numeric variable panel_id

. if _rc {
.     display as error "panel_id should be numeric."
.     exit 109
. }

. bysort ISO3: assert _N == 18

. xtset panel_id Year

Panel variable: panel_id (strongly balanced)
 Time variable: Year, 2005 to 2022
         Delta: 1 unit

. capture drop yd_*

. quietly tabulate Year, generate(yd_)

. * Non-redundant full-rank 2005-2022 time-indicator bases, empirically
. * verified against all six archived Stata estimates before changing code.
. * Difference GMM: yd_17 was auto-omitted for perfect collinearity.
. * System GMM: yd_4 was auto-omitted for perfect collinearity.
. * Explicitly omit the aliases rather than passing singular moment matrices.
. global digital_year_dummies_diff "yd_2-yd_16 yd_18"

. global digital_year_dummies_sys "yd_2-yd_3 yd_5-yd_18"

. display as result "STATA_DATA_PREFLIGHT_OK n=" _N
STATA_DATA_PREFLIGHT_OK n=846

. display as text "The raw data and two-way time indicators passed structure checks; no GMM was f
> itted yet."
The raw data and two-way time indicators passed structure checks; no GMM was fitted yet.

. 
end of do-file

. local preflight_rc=_rc

. if `preflight_rc'!=0 {
.     display as error "INTEGRATION_DATA_PREFLIGHT_FAILED rc=`preflight_rc'"
.     log close
.     exit `preflight_rc'
. }

. do "stata/00_model_helpers.do"

. * Registers real outcomes only. Models are NEVER marked scientifically accepted here.
. capture program drop digital_success

. program define digital_success
  1.     version 16.0
  2.     syntax , NAME(string)
  3.     local inst = e(j)
  4.     local groups = e(N_g)
  5.     local verdict "DIAGNOSTIC_HOLD"
  6.     if missing(`inst') | missing(`groups') {
  7.         local verdict "MISSING_INSTRUMENT_DIAGNOSTIC"
  8.     }
  9.     if !missing(`inst') & !missing(`groups') {
 10.         if `inst' >= `groups' local verdict "INSTRUMENTS_GE_GROUPS"
 11.     }
 12.     post digital_post ("`name'") ("`verdict'") (0) (e(N)) (e(N_g)) (e(j)) (e(sarganp)) (e(ha
> nsenp)) (e(ar1p)) (e(ar2p))
 13.     display as result "STATA_MODEL_ESTIMATED=`name' status=`verdict' instruments=" e(j) " gr
> oups=" e(N_g)
 14.     display as text "Sargan p=" e(sarganp) " Hansen p=" e(hansenp) " AR1 p=" e(ar1p) " AR2 p
> =" e(ar2p)
 15.     capture noisily estimates store `name'
 16.     capture noisily estimates save "outputs/stata/`name'.ster", replace
 17.     capture noisily matrix list e(diffsargan)
 18. end

. capture program drop digital_failure

. program define digital_failure
  1.     version 16.0
  2.     syntax , NAME(string) RC(integer)
  3.     post digital_post ("`name'") ("FAILED_EXECUTION") (`rc') (.) (.) (.) (.) (.) (.) (.)
  4.     display as error "STATA_MODEL_FAILED=`name' return_code=`rc'"
  5. end

. 
end of do-file

