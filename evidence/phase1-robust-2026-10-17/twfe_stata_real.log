. foreach y in Growth ln_Productivity D_ln_Productivity {
  2.  if "`y'"=="D_ln_Productivity" {
  3.   local regressors "D_Internet D_Broadband D_ICT_Exports D_Unemployment D_Inflation D_RnD"
  4.   local digital "D_Internet D_Broadband D_ICT_Exports"
  5.  }
  6.  else {
  7.   local regressors "Internet Broadband ICT_Exports Unemployment Inflation RnD"
  8.   local digital "Internet Broadband ICT_Exports"
  9.  }
 10.  display as result "TWFE_START model=`y'"
 11.  capture noisily xtreg `y' `regressors' i.Year, fe vce(cluster panel_id)
 12.  local result_rc=_rc
 13.  if `result_rc' !=0 {
 14.   post results ("`y'") ("FAIL") (`result_rc') (.) (.) (.) (.) (.) (.)
 15.   display as error "TWFE_FAIL model=`y' rc=`result_rc'"
 16.  }
 17.  else {
 18.   local n=e(N)
 19.   local ng=e(N_g)
 20.   local joint=.
 21.   capture noisily test `digital'
 22.   if _rc==0 local joint=r(p)
 23.   foreach v of local regressors {
 24.    local b=_b[`v']
 25.    local se=_se[`v']
 26.    local p=2*ttail(e(df_r),abs(`b'/`se'))
 27.    post results ("`y'") ("`v'") (0) (`n') (`ng') (`b') (`se') (`p') (`joint')
 28.    display as result "TWFE_TERM model=`y' var=`v' b=" %18.12g `b' " se=" %18.12g `se' " p=" %18.12g `p'
 29.   }
 30.   display as result "TWFE_OK model=`y' N=`n' groups=`ng' joint_cluster_p=`joint'"
 31.  }
 32. }
