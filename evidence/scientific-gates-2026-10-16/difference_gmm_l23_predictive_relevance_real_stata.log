. which xtabond2
D:/Digital_Economy_Stata_Ready/plus\x\xtabond2.ado
*! xtabond2 3.7.2 9 February 2025
*! Copyright (C) 2003-25 David Roodman. May be distributed free.

. use "data/processed/stata_ready.dta", clear

. isid ISO3 Year

. assert inrange(Year, 2005, 2022)

. foreach v of varlist Growth Productivity Internet Broadband ICT_Exports Unemployment Inflation R
> nD {
  2.     assert !missing(`v')
  3. }

. assert Productivity > 0

. capture confirm variable ln_Productivity

. if _rc {
.     generate double ln_Productivity = ln(Productivity)
. }

. else {
.     assert !missing(ln_Productivity)
.     assert abs(ln_Productivity - ln(Productivity)) < 1e-7
. }

. capture confirm variable panel_id

. if _rc {
.     encode ISO3, generate(panel_id)
. }

. capture confirm numeric variable panel_id

. if _rc {
.     display as error "panel_id should be numeric."
.     exit 109
. }

. bysort ISO3: assert _N == 18

. xtset panel_id Year

Panel variable: panel_id (strongly balanced)
 Time variable: Year, 2005 to 2022
         Delta: 1 unit

. capture drop yd_*

. quietly tabulate Year, generate(yd_)

. * Non-redundant full-rank 2005-2022 time-indicator bases, empirically
. * verified against all six archived Stata estimates before changing code.
. * Difference GMM: yd_17 was auto-omitted for perfect collinearity.
. * System GMM: yd_4 was auto-omitted for perfect collinearity.
. * Explicitly omit the aliases rather than passing singular moment matrices.
. global digital_year_dummies_diff "yd_2-yd_16 yd_18"

. global digital_year_dummies_sys "yd_2-yd_3 yd_5-yd_18"

. display as result "STATA_DATA_PREFLIGHT_OK n=" _N
STATA_DATA_PREFLIGHT_OK n=846

. display as text "The raw data and two-way time indicators passed structure checks; no GMM was fi
> tted yet."
The raw data and two-way time indicators passed structure checks; no GMM was fitted yet.

. 
end of do-file

. postfile q str22 variable str24 target double rc N countries coefficient_l2 coefficient_l3 joint
> _F joint_p r2 using "outputs/professor/diff_l23_lag_relevance.dta", replace
(file outputs/professor/diff_l23_lag_relevance.dta not found)

. foreach v in Growth ln_Productivity Internet Broadband ICT_Exports Unemployment Inflation RnD {
  2.   local target "D.`v'"
  3.   if inlist("`v'","Growth","ln_Productivity") local target "D.L.`v'"
  4.   display as result "DIFF_RELEVANCE_START v=`v' target=`target'"
  5.   capture noisily regress `target' L2.`v' L3.`v' i.Year, vce(cluster panel_id)
  6.   local rc = _rc
  7.   if `rc' == 0 {
  8.     local n=e(N)
  9.     local ncountry=e(N_clust)
 10.     local b2=_b[L2.`v']
 11.     local b3=_b[L3.`v']
 12.     local r2=e(r2)
 13.     capture noisily test L2.`v' L3.`v'
 14.     local testrc=_rc
 15.     local f=.
 16.     local p=.
 17.     if `testrc'==0 {
 18.        local f=r(F)
 19.        local p=r(p)
 20.     }
 21.     post q ("`v'") ("`target'") (0) (`n') (`ncountry') (`b2') (`b3') (`f') (`p') (`r2')
 22.     display as result "DIFF_RELEVANCE_OK v=`v' N=`n' groups=`ncountry' F=`f' p=`p'"
 23.   }
 24.   else {
 25.     post q ("`v'") ("`target'") (`rc') (.) (.) (.) (.) (.) (.) (.)
 26.     display as error "DIFF_RELEVANCE_FAILED v=`v' rc=`rc'"
 27.   }
 28. }
